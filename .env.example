# Required shared key sent in X-API-Key (at least 16 characters).
API_KEY=replace-with-a-random-api-key
# lightpanda uses Chromium only for ticket image generation.
# chromium runs the complete workflow using the approved fallback.
BROWSER_ENGINE=lightpanda
LIGHTPANDA_PATH=/usr/local/bin/lightpanda
LIGHTPANDA_HOST=127.0.0.1
LIGHTPANDA_PORT=9222
BROWSER_START_TIMEOUT=30
PAGE_TIMEOUT_MS=30000
REQUEST_TIMEOUT=180
MAX_CONCURRENT_SESSIONS=1
ALLOWED_ORIGINS=[]
LOG_LEVEL=INFO
PORT=10000
